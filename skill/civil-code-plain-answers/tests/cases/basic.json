        "no_legal_block": true
      }
    },
    {
      "case_id": "T14",
      "gate_refs": [
        "G01",
        "G07"
      ],
      "turns": [
        "押金没退，有没有相关法条？我现在没网"
      ],
      "expect": {
        "text_contains": [
          "第七百一十条"
        ],
        "text_not_contains": [
