{
  "schema_version": "2.0",
  "note": "基础用例。expect 中的断言由 tests/run_tests.py 逐项执行；结果为 NOT_RUN 时不得写入 PASS。",
  "cases": [
    {
      "case_id": "T01",
      "gate_refs": [
        "G09",
        "G05"
      ],
      "turns": [
        "押金还没退，我该先看什么？"
      ],
      "expect": {
        "outcome_in": [
          "NEEDS_INPUT",
          "ANSWERED"
        ],
        "runtime_status": "OK",
        "text_contains": [
          "先看合同里两处"
        ],
        "text_not_contains": [
          "PENDING_REVIEW",
          "references/",
          "退出码",
          "第七百一十条"
        ],
        "max_questions": 2,
        "max_text_len": 420,
        "no_legal_block": true
      }
    },
    {
      "case_id": "T02",
      "gate_refs": [
        "G03",
        "G05"
      ],
      "turns": [
        "押金还没退，我该先看什么？",
        "钥匙交了。他说墙上有印子，要扣 2000 元。"
      ],
      "expect": {
        "outcome_in": [
          "NEEDS_INPUT",
          "ANSWERED"
        ],
        "facts": {
          "keys_returned": true,
          "claimed_amount": "2000"
        },
        "text_contains": [
          "2000"
        ],
        "text_not_contains": [
          "扣 2000 是合理的",
          "该扣 2000"
        ],
        "max_questions": 2,
        "no_legal_block": true
      }
    },
    {
      "case_id": "T03",
      "gate_refs": [
        "G03",
        "G04"
      ],
      "turns": [
        "押金还没退，我该先看什么？",
        "钥匙交了。他说墙上有印子，要扣 2000 元。",
        "我刚才说错了，钥匙还没交，我还住着。入住照片上就有这个印子。"
      ],
      "expect": {
        "facts": {
          "keys_returned": false,
          "occupancy_still_living": true
        },
        "text_contains": [
          "还住着"
        ],
        "text_not_contains": [
          "钥匙已交回",
          "已交钥匙"
        ],
        "max_questions": 2,
        "no_legal_block": true
      }
    },
    {
      "case_id": "T04",
      "gate_refs": [
        "G03"
      ],
      "turns": [
        "押金没退，我没说已经退房"
      ],
      "expect": {
        "facts_absent": [
          "occupancy_moved_out"
        ],
        "text_not_contains": [
          "已搬离",
          "已经搬走",
          "你已经不住"
        ],
        "no_legal_block": true
      }
    },
    {
      "case_id": "T05",
      "gate_refs": [
        "G03",
        "G04"
      ],
      "turns": [
        "押金没退，钥匙我已经交了",
        "房东说没有收到钥匙，各执一词"
      ],
      "expect": {
        "reason_codes_include": [
          "FACT_CONFLICT"
        ],
        "text_contains": [
          "不一致"
        ],
        "text_not_contains": [
          "钥匙已交回",
          "已经证明"
        ],
        "no_legal_block": true
      }
    },
    {
      "case_id": "T06",
      "gate_refs": [
        "G03",
        "G05"
      ],
      "turns": [
