      ],
      "expect": {
        "text_contains": [
          "入住"
        ],
        "text_not_contains": [
          "确实损坏",
          "属于损坏",
          "你必须赔"
        ],
        "max_questions": 2,
        "no_legal_block": true
      }
    },
    {
